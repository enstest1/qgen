# DEMO only. No money moves in demo mode.
PORT=3000
HOST=127.0.0.1
CHAIN_MODE=demo
DB_PATH=./data/registry.sqlite
COLLECTION_SUPPLY=256
COLLECTION_ANCHOR_HEIGHT=200000
# Mainnet is intentionally disabled until atomic fee split and wallet allowlist are proven.
MAINNET_MINT_ENABLED=false
ATOMIC_DEV_FEE_VERIFIED=false
DEVELOPER_QTC_OWNER=
DEV_FEE_USD=3
# Required only for live read-only verification; must point at a trusted, pinned source.
QUANTUS_BLOCK_URL_TEMPLATE=
QUANTUS_STATUS_URL=
QLYPHS_INSCRIPTION_URL_TEMPLATE=
# Required for exact live fee quotes; Qlyphs wallet itself must still verify the fee.
QLYPHS_FEES_URL=
EXPECTED_MAINNET_GENESIS=

PUBLIC_ORIGIN=https://qgen.lol
QLYPHS_WALLET_ORIGIN=https://keys.qlyphs.com
